# Firebase web app settings (public client configuration; no service-account key)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# UID of the single administrator authorized by the app and Realtime Database rules.
# Update this value and firebase/database.rules.json together when replacing the administrator.
VITE_ADMIN_UID=

# Existing contact form and firm details
VITE_SITE_URL=
VITE_WEB3FORMS_ACCESS_KEY=
VITE_FIRM_PHONE=
VITE_FIRM_EMAIL=
